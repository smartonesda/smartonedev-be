# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK (Cloud Firestore)
# Pilih salah satu metode di bawah (Opsi 1 paling direkomendasikan untuk dev & Vercel):
#
# Opsi 1: Env variables terpisah (dari file JSON Service Account Firebase)
FIREBASE_PROJECT_ID=smartonedev-sda
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@smartonedev-sda.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Opsi 2 (alternatif lokal): Path ke file JSON Service Account
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#
# Opsi 3 (alternatif Vercel): Full JSON atau Base64 dari file Service Account
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudinary (Image Storage pengganti Supabase Storage - Free Tier)
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
CLOUDINARY_FOLDER=smartonedev/gallery

# JWT
JWT_SECRET=<your_jwt_secret_min_32_chars>
JWT_EXPIRES_IN=7d

# Admin Credentials (untuk initial seed & fallback auth)
ADMIN_USERNAME=smartonedev
ADMIN_PASSWORD=smartonedev
